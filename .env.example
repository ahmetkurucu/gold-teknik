# Sunucu portu
PORT=3001

# Yönetim paneli şifresi (mutlaka değiştirin)
ADMIN_PASSWORD=goldteknik2026

# Oturum token'larını imzalamak için rastgele, uzun bir metin
# (üretmek için: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-string

# --- E-posta bildirimleri (opsiyonel) ---
# Bu değerleri doldurursanız, yeni bir teklif geldiğinde otomatik e-posta gönderilir.
# Boş bırakırsanız e-posta bildirimi kapalı kalır, site normal çalışmaya devam eder.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=info@goldteknik.com
